# Copy to .env and fill in
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults in citerag/config.py)
# CITERAG_LLM_MODEL=claude-opus-5-5
# CITERAG_LLM_EFFORT=medium                   # low | medium | high | xhigh | max
# CITERAG_EMBED_MODEL=BAAI/bge-base-en-v1.5   # changing it needs: python -m citerag.store data/ --reset
# CITERAG_EMBED_DEVICE=mps                     # default: cuda > mps > cpu
# CITERAG_CHUNK_SIZE=384
# CITERAG_CHUNK_OVERLAP=64
# CITERAG_TOP_K=5
# CITERAG_MIN_SCORE=0.45                      # 'not in the documents' gate (cosine)
# CITERAG_USE_RERANKER=1                      # optional cross-encoder reranking (slower)
