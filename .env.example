# Copy to .env and fill in
ANTHROPIC_API_KEY=sk-ant-...

# Free alternative: Google Gemini (key from https://aistudio.google.com/apikey).
# Free tier: Google may use prompts/responses to improve its products - no sensitive documents.
# CITERAG_LLM_PROVIDER=gemini
# GEMINI_API_KEY=...

# Optional overrides (defaults in citerag/config.py)
# CITERAG_LLM_MODEL=claude-opus-5-5
# CITERAG_LLM_EFFORT=medium                   # low | medium | high | xhigh | max
# CITERAG_EMBED_MODEL=BAAI/bge-base-en-v1.5   # changing it needs: python -m citerag.store data/ --reset
# CITERAG_EMBED_DEVICE=mps                     # default: cuda > mps > cpu
# CITERAG_PDF_PARSER=docling                 # or pypdf: plain text extraction, no layout model
# CITERAG_PDF_FORMULAS=text                  # or latex: formula model (1.2 GB, ~20 s/formula), kept only when it matches the PDF text
# CITERAG_CHATS_DIR=.chats                   # saved conversations (they quote your documents)
# CITERAG_EMAIL_ATTACHMENTS=1               # 0: list an email's attachments by name, don't read them
# CITERAG_OCR=rapidocr                       # or ocrmac (Apple Vision, macOS, pip install ocrmac), or off
# CITERAG_PARSE_CACHE_DIR=.cache/parsed      # parsed PDFs, keyed by file content and parser settings
# CITERAG_CHUNK_SIZE=384
# CITERAG_CHUNK_OVERLAP=64
# CITERAG_TOP_K=5
# CITERAG_MIN_SCORE=0.45                      # 'not in the documents' gate (cosine)
# CITERAG_USE_RERANKER=0                      # turn off cross-encoder reranking (on by default; +0.4 s/question)
# CITERAG_RETRIEVE_CANDIDATES=10              # chunks per search that get fused and reranked
# CITERAG_VALIDATE=0                          # skip the citation checks (Phase 6)
# CITERAG_STRICT=1                            # remove statements that fail the checks
# CITERAG_NLI_MODEL=MoritzLaurer/DeBERTa-v3-large-mnli-fever-anli-ling-wanli  # more accurate, ~3x slower
# CITERAG_NLI_THRESHOLD=0.5                   # P(entailment) needed to count as supported
